# MQTT broker (required)
MQTT_HOST=your_mqtt_broker_ip
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# Log capture (optional, defaults shown)
LOG_DIR=/data/logs
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=3
LOG_RETENTION_DAYS=7
LOG_MAX_TOTAL_MB=100

# MCP transport (stdio for gateway, sse for standalone)
MCP_TRANSPORT=sse

# Timezone (optional, defaults to UTC)
TZ=America/Los_Angeles
